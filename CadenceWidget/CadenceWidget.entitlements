<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WidgetKit extensions on macOS must be sandboxed; pkd refuses to
         register the extension otherwise. The main app stays unsandboxed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.alexmathews.cadence</string>
    </array>
</dict>
</plist>
