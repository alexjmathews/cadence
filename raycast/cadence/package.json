{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "cadence",
  "title": "Cadence",
  "description": "Control the Cadence pomodoro app from Raycast.",
  "icon": "command-icon.png",
  "author": "alexmathews",
  "license": "MIT",
  "commands": [
    {
      "name": "start-session",
      "title": "Start Session",
      "subtitle": "Cadence",
      "description": "Start a Cadence session using the stored plan — the duration you last chose.",
      "mode": "no-view",
      "icon": "command-icon.png"
    },
    {
      "name": "start-timer",
      "title": "Start Timer",
      "subtitle": "Cadence",
      "description": "Start a Cadence session of a given length. Leave the duration blank to use the stored plan.",
      "mode": "no-view",
      "icon": "command-icon.png",
      "arguments": [
        {
          "name": "minutes",
          "type": "text",
          "placeholder": "minutes",
          "required": false
        }
      ]
    },
    {
      "name": "pause",
      "title": "Pause Session",
      "subtitle": "Cadence",
      "description": "Pause the running Cadence session.",
      "mode": "no-view",
      "icon": "command-icon.png"
    },
    {
      "name": "resume",
      "title": "Resume Session",
      "subtitle": "Cadence",
      "description": "Resume the paused Cadence session.",
      "mode": "no-view",
      "icon": "command-icon.png"
    },
    {
      "name": "reset",
      "title": "Reset Session",
      "subtitle": "Cadence",
      "description": "Reset Cadence back to idle.",
      "mode": "no-view",
      "icon": "command-icon.png"
    },
    {
      "name": "extend",
      "title": "Extend Session",
      "subtitle": "Cadence",
      "description": "Add five more minutes to a completed Cadence session.",
      "mode": "no-view",
      "icon": "command-icon.png"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.80.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.8.10",
    "@types/react": "^18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  }
}
